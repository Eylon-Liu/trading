<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quant.web</string>

    <!-- Keeps the web UI running on this Mac: started at login, restarted if
         it exits. Reach it from a phone through Tailscale
         (docs/remote-access.md). __ROOT__ and __PYTHON__ are filled in by
         `tools/setup_schedule.sh install-web`. -->

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__ROOT__/app.py</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>__ROOT__</string>

    <key>StandardOutPath</key>
    <string>__ROOT__/logs/web.log</string>
    <key>StandardErrorPath</key>
    <string>__ROOT__/logs/web.log</string>
</dict>
</plist>
